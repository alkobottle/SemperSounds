# Copy to .env and fill in. .env is gitignored — never commit real values.

# Discord developer portal -> your application -> Bot -> Reset Token
Discord__BotToken=

# Discord developer portal -> your application -> OAuth2
Discord__ClientId=
Discord__ClientSecret=

# Right-click your server in Discord (Developer Mode on) -> Copy Server ID
Discord__GuildId=

# The URL users actually reach. Behind a TLS-terminating proxy this must be the
# https address, otherwise the app builds an http:// OAuth redirect_uri and
# Discord rejects the login.
App__PublicBaseUrl=https://sounds.example.com
