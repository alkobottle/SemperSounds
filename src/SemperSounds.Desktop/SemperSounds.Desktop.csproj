<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- What Explorer and the taskbar show for the .exe itself. -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <!-- Required by LibraryImport's generated marshalling; no unsafe code is written by hand. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Trimmed, which takes the download from 246 MB to about 25 MB.

      This is only safe because every shape that gets serialised now has build-time metadata:
      SoundboardJsonContext for the hub, PairingJsonContext for pairing, DesktopConfigJsonContext
      for the settings file. Trimming disables reflection-based serialization outright, and the
      failure is an exception on the very first use - adding a serialised type without adding it
      to a context will break the app at startup or on the first key press.

      Partial mode on purpose: SukiUI and Avalonia's DataGrid are not marked trimmable and are
      left whole, which is what keeps their reflection working.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>

    <!--
      Squeezes the bundled framework and native libraries. It costs a moment on first launch,
      when the runtime extracts them to a cache folder, and nothing on launches after that.
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Symbols inside the assembly rather than beside it: stack traces keep their line
         numbers without three loose .pdb files travelling with a single-file app. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemperSounds.Contracts\SemperSounds.Contracts.csproj" />
    <ProjectReference Include="..\SemperSounds.Desktop.Core\SemperSounds.Desktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />

    <!--
      Local preview playback: Avalonia draws and has no audio of its own. WinMM specifically,
      not the NAudio metapackage - that one also pulls NAudio.WinForms, which drags the entire
      Windows Forms runtime pack into a single-file build for an app that draws no WinForms.
      WinMM alone carries WaveOut and Mp3FileReader, which is all this needs.
    -->
    <PackageReference Include="NAudio.WinMM" Version="3.1.0" />

    <PackageReference Include="SukiUI" Version="7.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    Skia and HarfBuzz ship their native .pdb files as package content, and they are 104 MB
    between them - two thirds of what anybody would download, for symbols belonging to
    libraries this project does not debug.
  -->
  <Target Name="DropNativeSymbols" AfterTargets="Publish">
    <ItemGroup>
      <NativeSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(NativeSymbols)" />
  </Target>

</Project>
