<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SemperSounds.Desktop.Views.ToastWindow"
        Width="320" Height="72"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Focusable="False">

    <!-- The darkest Discord surface, so it reads as part of the same family over a game. -->
    <Border Background="#1E1F22" CornerRadius="8" Padding="14,10" BorderThickness="1" BorderBrush="#3F4147">
        <StackPanel Spacing="2">
            <TextBlock Name="TitleText" FontWeight="SemiBold" FontSize="14" Foreground="#F2F3F5"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Name="DetailText" FontSize="12" Foreground="#949BA4" TextWrapping="Wrap" MaxLines="2" />
        </StackPanel>
    </Border>

</Window>
