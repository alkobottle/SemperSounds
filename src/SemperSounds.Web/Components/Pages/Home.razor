@page "/board"
@attribute [Authorize]
@implements IDisposable
@inject SoundLibrary Library
@inject FavoriteLibrary Favorites
@* Named Entries, not EntrySounds: that would collide with the SemperSounds.Core.EntrySounds
   namespace, which _Imports pulls into scope. *@
@inject EntrySoundLibrary Entries
@inject ActivityLog Activity
@inject PlayStatistics Statistics
@inject PlaybackService Playback
@inject SoundboardEvents Events
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>SemperSounds</PageTitle>

<MudGrid>
    <MudItem xs="12" md="9">
        @* Favourites sit above the search box and are deliberately unaffected by it:
           their whole purpose is that they stay put and their keys keep working. *@
        @if (_favorites.Count > 0)
        {
            <div class="d-flex align-center gap-2 mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2">Favourites</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">press 1–@FavoriteLibrary.MaxSlots</MudText>
            </div>

            <MudGrid Spacing="2" Class="mb-4">
                @foreach (var favorite in _favorites)
                {
                    var sound = favorite.Sound!;
                    <MudItem xs="6" sm="4" md="3" lg="2">
                        <MudPaper Class="pa-2" Elevation="3" Style="border-left: 3px solid var(--mud-palette-warning);">
                            <div class="d-flex align-center mb-1" style="gap: 8px;">
                                <SoundEmojiView Value="@sound.Emoji" Size="28" />
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <MudText Typo="Typo.body2" Class="ss-truncate" title="@sound.Name">
                                        @sound.Name
                                    </MudText>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                    @favorite.Slot
                                </MudChip>
                            </div>

                            <div class="d-flex gap-1">
                                @{
                                    var favoritePlaying = _playingIds.Contains(sound.Id);
                                }
                                <MudButton Variant="Variant.Filled"
                                           Color="@(favoritePlaying ? Color.Success : Color.Primary)"
                                           Size="Size.Small"
                                           StartIcon="@(favoritePlaying ? Icons.Material.Filled.GraphicEq : Icons.Material.Filled.PlayArrow)"
                                           Disabled="@(!_canPlay || favoritePlaying)"
                                           OnClick="@(() => Play(sound))"
                                           Class="flex-grow-1">
                                    @(favoritePlaying ? "Playing" : "Play")
                                </MudButton>
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                               Size="Size.Small"
                                               Disabled="@(favorite.Slot == 1)"
                                               OnClick="@(() => Move(sound.Id, up: true))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                               Size="Size.Small"
                                               Disabled="@(favorite.Slot == _favorites.Count)"
                                               OnClick="@(() => Move(sound.Id, up: false))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Star"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               OnClick="@(() => ToggleFavorite(sound))" />
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <MudDivider Class="mb-4" />
        }

        @* flex-wrap because this row now carries search, sort and uploader: without it they
           are squeezed rather than stacked at 414px. *@
        <div class="d-flex align-center flex-wrap gap-4 mb-4">
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="ApplyView"
                          Immediate="true"
                          Placeholder="Search sounds..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true" />

            <MudSelect T="BoardSort"
                       Value="_preferences.Sort"
                       ValueChanged="SortChanged"
                       Label="Sort"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="max-width: 190px;"
                       Class="flex-shrink-0">
                @foreach (var sort in Enum.GetValues<BoardSort>())
                {
                    <MudSelectItem T="BoardSort" Value="@sort">@SortLabel(sort)</MudSelectItem>
                }
            </MudSelect>

            @if (_uploaders.Count > 1)
            {
                <MudSelect T="ulong?"
                           Value="_preferences.UploaderId"
                           ValueChanged="UploaderChanged"
                           Label="Uploader"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Clearable="true"
                           Style="max-width: 190px;"
                           Class="flex-shrink-0">
                    <MudSelectItem T="ulong?" Value="@((ulong?)null)">Anyone</MudSelectItem>
                    @foreach (var uploader in _uploaders)
                    {
                        <MudSelectItem T="ulong?" Value="@((ulong?)uploader.Id)">
                            @uploader.Name (@uploader.Count)
                        </MudSelectItem>
                    }
                </MudSelect>
            }

            @* Kept, and now doing more work than before: with a sort and four filters there
               are more ways to be looking at a subset than there used to be. *@
            <MudText Typo="Typo.body2" Class="mud-text-secondary flex-shrink-0">
                @_filtered.Count / @_all.Count
            </MudText>
        </div>

        <div class="d-flex align-center flex-wrap gap-2 mb-4">
            <MudChipSet T="BoardFilter"
                        @bind-SelectedValues="_selectedFilters"
                        @bind-SelectedValues:after="FiltersChanged"
                        SelectionMode="SelectionMode.MultiSelection"
                        CheckMark="true">
                @foreach (var (filter, label, icon) in FilterChips)
                {
                    <MudChip T="BoardFilter"
                             Value="@filter"
                             Icon="@icon"
                             Size="Size.Small"
                             Color="Color.Secondary"
                             Variant="@(_selectedFilters.Contains(filter) ? Variant.Filled : Variant.Outlined)">
                        @label
                    </MudChip>
                }
            </MudChipSet>
        </div>

        @if (_allTags.Count > 0)
        {
            @* CheckMark belongs on the set, not the chip — on MudChip it trips the MUD0002
               analyzer. MudBlazor ships no filled-and-selected CSS rule and has no
               SelectedVariant parameter, so the fill has to be switched per chip; selecting
               one otherwise only added a ~6% tint and was effectively invisible. *@
            <div class="d-flex align-center flex-wrap gap-2 mb-4">
                <MudChipSet T="string"
                            @bind-SelectedValues="_selectedTags"
                            @bind-SelectedValues:after="TagsChanged"
                            SelectionMode="SelectionMode.MultiSelection"
                            CheckMark="true">
                    @foreach (var tag in _allTags)
                    {
                        <MudChip T="string"
                                 Value="@tag"
                                 Size="Size.Small"
                                 Color="Color.Primary"
                                 Variant="@(_selectedTags.Contains(tag) ? Variant.Filled : Variant.Outlined)">
                            @tag
                        </MudChip>
                    }
                </MudChipSet>

                @if (_selectedTags.Count > 0)
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               OnClick="ClearTagFilter">
                        Clear
                    </MudButton>
                }
            </div>
        }

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_filtered.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                @(_all.Count == 0
                    ? "No sounds yet. Head to Upload and add the first one."
                    : "Nothing matches that filter.")
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var sound in _filtered)
                {
                    var isFavorite = _favoriteIds.Contains(sound.Id);
                    var isPlaying = _playingIds.Contains(sound.Id);
                    var isEntrySound = _entrySoundId == sound.Id;

                    <MudItem xs="6" sm="4" md="3" lg="2">
                        <MudPaper Class="pa-3 d-flex flex-column" Style="height: 100%;" Elevation="2">
                            <div class="d-flex align-center mb-1" style="gap: 10px;">
                                <SoundEmojiView Value="@sound.Emoji" Size="34" />

                                <div class="flex-grow-1" style="min-width: 0;">
                                    <MudText Typo="Typo.subtitle2" Class="ss-clamp-2" title="@sound.Name">
                                        @sound.Name
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-flex align-center" Style="gap: 5px;">
                                        @* The whole expression must sit inside @(...): a trailing .ToString()
                                           after the closing paren is emitted as literal text. *@
                                        <span>@((sound.DurationMs / 1000.0).ToString("0.0"))s</span>
                                        <span>·</span>
                                        <UserAvatar UserId="@sound.UploaderId"
                                                    FallbackName="@sound.UploaderName"
                                                    Pixels="16" />

                                        @* The play count lives here rather than getting its own row or
                                           chip: the tile's action row is already four buttons wide inside
                                           an xs=6 column and wraps at 414px. Nothing renders at zero —
                                           most of the library sits there and "0" is just noise. It is
                                           also the way into the detail dialog, so that costs no button. *@
                                        @if (_stats.TryGetValue(sound.Id, out var stats) && stats.Plays > 0)
                                        {
                                            <span>·</span>
                                            @* Trending swaps this icon rather than adding a badge:
                                               one glyph, no extra control, no layout change. *@
                                            <MudTooltip Text="@(stats.IsTrending
                                                                  ? $"Trending — {stats.PlaysThisWeek} plays this week, up from {stats.PlaysPreviousWeek}"
                                                                  : "Play history")">
                                                <span class="d-inline-flex align-center"
                                                      style="gap: 3px; cursor: pointer;"
                                                      @onclick="@(() => ShowStats(sound))">
                                                    <MudIcon Icon="@(stats.IsTrending
                                                                       ? Icons.Material.Filled.LocalFireDepartment
                                                                       : Icons.Material.Filled.PlayArrow)"
                                                             Color="@(stats.IsTrending ? Color.Warning : Color.Inherit)"
                                                             Size="Size.Small" />
                                                    <span>@stats.Plays</span>
                                                </span>
                                            </MudTooltip>
                                        }
                                    </MudText>
                                </div>

                                @* Both live in the header rather than the button row below:
                                   the header is the "my relationship to this sound" slot, and
                                   that row is already four buttons wide inside an xs=6 tile. *@
                                <MudTooltip Text="@(isEntrySound ? "Stop using as my entry sound" : "Use as my entry sound")">
                                    <MudIconButton Icon="@Icons.Material.Filled.SensorDoor"
                                                   Color="@(isEntrySound ? Color.Secondary : Color.Default)"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ToggleEntrySound(sound))" />
                                </MudTooltip>

                                <MudTooltip Text="@(isFavorite ? "Remove from favourites" : "Add to favourites")">
                                    <MudIconButton Icon="@(isFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                                   Color="@(isFavorite ? Color.Warning : Color.Default)"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ToggleFavorite(sound))" />
                                </MudTooltip>
                            </div>

                            <MudSpacer />

                            <div class="d-flex gap-1 mt-2">
                                <MudButton Variant="Variant.Filled"
                                           Color="@(isPlaying ? Color.Success : Color.Primary)"
                                           Size="Size.Small"
                                           StartIcon="@(isPlaying ? Icons.Material.Filled.GraphicEq : Icons.Material.Filled.PlayArrow)"
                                           Disabled="@(!_canPlay || isPlaying)"
                                           OnClick="@(() => Play(sound))"
                                           Class="flex-grow-1">
                                    @(isPlaying ? "Playing" : "Play")
                                </MudButton>

                                <MudTooltip Text="Preview in your browser only">
                                    <MudIconButton Icon="@Icons.Material.Filled.Headphones"
                                                   Size="Size.Small"
                                                   OnClick="@(() => Preview(sound))" />
                                </MudTooltip>

                                <MudTooltip Text="Edit emoji, name and tags">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   OnClick="@(() => Edit(sound))" />
                                </MudTooltip>

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => Delete(sound))" />
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Recent activity</MudText>
            @if (_recent.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing yet.</MudText>
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var entry in _recent)
                    {
                        <MudListItem T="string">
                            <MudText Typo="Typo.body2">
                                <ActivityLine Entry="@entry" />
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @entry.OccurredAt.ToLocalTime().ToString("HH:mm:ss")
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@* Hidden element used to play previews locally without touching the voice channel. *@
<audio @ref="_previewPlayer" style="display:none"></audio>

@code {
    private List<Favorite> _favorites = [];
    private HashSet<Guid> _favoriteIds = [];
    private Guid? _entrySoundId;
    private IReadOnlySet<Guid> _playingIds = new HashSet<Guid>();

    private List<Sound> _all = [];
    private List<Sound> _filtered = [];
    private List<string> _allTags = [];
    private IReadOnlyCollection<string> _selectedTags = [];
    private List<ActivityLogEntry> _recent = [];

    /// <summary>
    /// Play counts by sound. A missing key means never played — the aggregate omits those
    /// rather than returning zeros.
    /// </summary>
    private Dictionary<Guid, SoundPlayStats> _stats = [];

    /// <summary>
    /// How the grid is ordered and narrowed. The tag chips keep their own binding for
    /// MudChipSet's sake and are folded in when the view is rebuilt.
    /// </summary>
    private BoardPreferences _preferences = new();

    /// <summary>Bound to the chip set, then folded into <see cref="_preferences"/> as flags.</summary>
    private IReadOnlyCollection<BoardFilter> _selectedFilters = [];

    /// <summary>Derived from the library the same way the tag list is, so no extra query
    /// and only people who actually have sounds appear.</summary>
    private List<(ulong Id, string Name, int Count)> _uploaders = [];

    private static readonly (BoardFilter Filter, string Label, string Icon)[] FilterChips =
    [
        (BoardFilter.FavouritesOnly, "Favourites", Icons.Material.Filled.Star),
        (BoardFilter.NeverPlayed, "Never played", Icons.Material.Filled.HistoryToggleOff),
        (BoardFilter.Untagged, "Untagged", Icons.Material.Filled.LabelOff),
    ];

    private string _search = string.Empty;
    private bool _loading = true;
    private bool _canPlay;
    private ulong _userId;
    private string _userName = string.Empty;
    private ElementReference _previewPlayer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = state.User.GetDiscordUserId();
        _userName = state.User.GetDisplayName();

        Events.SoundPlayed += OnSoundPlayed;
        Events.LibraryChanged += OnLibraryChanged;
        Events.ConnectionChanged += OnConnectionActivity;
        Events.VoiceStateChanged += OnConnectionChanged;
        Events.PlaybackChanged += OnPlaybackChanged;

        await ReloadAsync();
        UpdateCanPlay();
        _loading = false;
    }

    private async Task ReloadFavoritesAsync()
    {
        _favorites = await Favorites.GetForUserAsync(_userId);
        _favoriteIds = await Favorites.GetFavoritedSoundIdsAsync(_userId);

        // Deleting a sound cascades the assignment away, so this is reloaded on the same
        // path as favourites rather than only once at startup.
        _entrySoundId = (await Entries.FindAsync(_userId))?.SoundId;
    }

    private async Task ToggleEntrySound(Sound sound)
    {
        if (_entrySoundId == sound.Id)
        {
            await Entries.ClearAsync(_userId);
            Snackbar.Add("Entry sound cleared", Severity.Success);
        }
        else
        {
            var result = await Entries.AssignAsync(_userId, sound.Id);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error, Severity.Warning);
                return;
            }

            Snackbar.Add($"{sound.Name} plays when you join", Severity.Success);
        }

        await ReloadFavoritesAsync();
    }

    private async Task ToggleFavorite(Sound sound)
    {
        var result = await Favorites.ToggleAsync(_userId, sound.Id);

        if (!result.IsFavorited && !string.IsNullOrEmpty(result.Error))
        {
            Snackbar.Add(result.Error, Severity.Warning);
            return;
        }

        await ReloadFavoritesAsync();
    }

    private async Task Move(Guid soundId, bool up)
    {
        await Favorites.MoveAsync(_userId, soundId, up);
        await ReloadFavoritesAsync();
    }

    private async Task ReloadAsync()
    {
        _all = await Library.GetAllAsync();
        _stats = new Dictionary<Guid, SoundPlayStats>(await Statistics.GetPerSoundAsync());
        await ReloadFavoritesAsync();
        _allTags = [.. _all.SelectMany(s => s.TagList).Distinct().OrderBy(t => t)];
        RebuildUploaders();
        ApplyView();

        _recent = await Activity.GetRecentAsync(15);
    }

    /// <summary>MudChipSet has no clear API; reassigning the bound field deselects them.</summary>
    private Task ClearTagFilter()
    {
        _selectedTags = [];
        return TagsChanged();
    }

    /// <summary>
    /// Named ApplyView, not ApplyFilter: it sorts as well now, and a method whose name has
    /// stopped describing what it does is how the next person gets misled.
    /// </summary>
    private void ApplyView() =>
        _filtered = BoardView.Apply(_all, _preferences, _search, _favoriteIds, _stats);

    // Only deliberate mode changes persist. The search box calls ApplyView directly, so a
    // sticky search term is impossible and nothing writes to storage per keystroke.

    private Task SortChanged(BoardSort sort)
    {
        _preferences = _preferences with { Sort = sort };
        ApplyView();
        return SavePreferencesAsync();
    }

    private Task UploaderChanged(ulong? uploaderId)
    {
        _preferences = _preferences with { UploaderId = uploaderId };
        ApplyView();
        return SavePreferencesAsync();
    }

    private Task TagsChanged()
    {
        _preferences = _preferences with { Tags = [.. _selectedTags] };
        ApplyView();
        return SavePreferencesAsync();
    }

    private Task FiltersChanged()
    {
        var flags = BoardFilter.None;
        foreach (var filter in _selectedFilters)
        {
            flags |= filter;
        }

        _preferences = _preferences with { Filters = flags };
        ApplyView();
        return SavePreferencesAsync();
    }

    /// <summary>
    /// Uploaders present in the library, most prolific first. Rebuilt wherever the tag list
    /// is, because both go stale for the same reasons.
    /// </summary>
    private void RebuildUploaders() =>
        _uploaders =
        [
            .. _all
                .GroupBy(s => s.UploaderId)
                .Select(group => (
                    Id: group.Key,
                    Name: group.First().UploaderName,
                    Count: group.Count()))
                .OrderByDescending(uploader => uploader.Count)
                .ThenBy(uploader => uploader.Name, StringComparer.OrdinalIgnoreCase)
        ];

    private static string SortLabel(BoardSort sort) => sort switch
    {
        BoardSort.MostPlayed => "Most played",
        BoardSort.RecentlyUploaded => "Newest",
        BoardSort.RecentlyPlayed => "Recently played",
        BoardSort.Longest => "Longest",
        BoardSort.Shortest => "Shortest",
        _ => "A–Z",
    };

    private void UpdateCanPlay() =>
        _canPlay = Playback.IsConnected;

    private async Task Edit(Sound sound)
    {
        var parameters = new DialogParameters<SoundEditDialog> { { x => x.Sound, sound } };
        var dialog = await Dialogs.ShowAsync<SoundEditDialog>("Edit sound", parameters);
        var result = await dialog.Result;

        if (result?.Canceled != false || result.Data is not SoundEditDialog.SoundEdit edit)
        {
            return;
        }

        if (await Library.UpdateAsync(sound.Id, edit.Name, edit.Tags, edit.Emoji))
        {
            Snackbar.Add($"Updated {edit.Name}", Severity.Success);
            Events.RaiseLibraryChanged();
        }
    }

    private async Task Play(Sound sound)
    {
        var result = await Playback.PlayAsync(sound.Id, _userId, _userName);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error, Severity.Warning);
        }
    }

    private Task ShowStats(Sound sound)
    {
        var parameters = new DialogParameters<SoundStatsDialog> { { x => x.Sound, sound } };
        return Dialogs.ShowAsync<SoundStatsDialog>("Play history", parameters);
    }

    private async Task Preview(Sound sound) =>
        await JS.InvokeVoidAsync("semperSounds.preview", _previewPlayer, $"/sounds/{sound.Id}/preview");

    private async Task Delete(Sound sound)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Delete sound",
            $"Delete \"{sound.Name}\"? Everyone in the server can do this, and it cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        if (await Library.DeleteAsync(sound.Id))
        {
            Snackbar.Add($"Deleted {sound.Name}", Severity.Success);
            Events.RaiseLibraryChanged();
        }
    }

    private void OnSoundPlayed(SoundPlayedNotification notification) => InvokeAsync(async () =>
    {
        // The count is nudged in memory rather than re-aggregated. Plays are bursty by
        // design, and every open circuit subscribes, so re-querying here would fire a
        // grouped scan per press per browser. PlayAsync writes exactly one row before
        // raising this, so the increment is exact rather than an estimate.
        if (notification.Kind == SoundboardActivity.Played)
        {
            CountPlayLocally(notification);
        }

        // The activity list is re-read rather than spliced, so plays, joins and leaves all
        // arrive through one path and stay in true chronological order.
        _recent = await Activity.GetRecentAsync(15);
        StateHasChanged();
    });

    /// <summary>
    /// Applies one play to the in-memory counts. Deliberately does not re-sort: under
    /// "most played" a live reorder would move tiles out from under the cursor mid-click,
    /// so the order is left until the next explicit reload.
    /// </summary>
    private void CountPlayLocally(SoundPlayedNotification notification)
    {
        var existing = _stats.GetValueOrDefault(
            notification.SoundId, new SoundPlayStats(notification.SoundId, 0, 0, 0, null));

        _stats[notification.SoundId] = existing with
        {
            Plays = existing.Plays + 1,
            PlaysThisWeek = existing.PlaysThisWeek + 1,
            LastPlayedAt = notification.PlayedAt,
        };
    }

    private void OnLibraryChanged() => InvokeAsync(async () =>
    {
        _all = await Library.GetAllAsync();
        _stats = new Dictionary<Guid, SoundPlayStats>(await Statistics.GetPerSoundAsync());
        _allTags = [.. _all.SelectMany(s => s.TagList).Distinct().OrderBy(t => t)];
        RebuildUploaders();
        // A sound someone else deleted cascades out of favourites, so reload them too.
        await ReloadFavoritesAsync();
        ApplyView();
        StateHasChanged();
    });

    private void OnConnectionChanged() => InvokeAsync(() =>
    {
        UpdateCanPlay();
        StateHasChanged();
    });

    // Raised from the playback pump thread, so it has to marshal onto the circuit.
    private void OnPlaybackChanged() => InvokeAsync(() =>
    {
        _playingIds = Playback.PlayingSoundIds;
        StateHasChanged();
    });

    private void OnConnectionActivity() => InvokeAsync(async () =>
    {
        // Joins and leaves belong in the same list as plays.
        _recent = await Activity.GetRecentAsync(15);
        UpdateCanPlay();
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hotkeyRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("semperSounds.registerHotkeys", _hotkeyRef);

            await RestorePreferencesAsync();
        }
    }

    /// <summary>
    /// Applies the stored sort and filters, if any.
    /// </summary>
    /// <remarks>
    /// Here rather than in OnInitializedAsync because rendering is prerendered: there is no
    /// JS runtime during that pass and any interop call throws. The cost is a brief flash of
    /// the default A–Z board before this lands, which is the accepted trade for localStorage —
    /// only a cookie is readable early enough to avoid it.
    /// </remarks>
    private async Task RestorePreferencesAsync()
    {
        string? stored;
        try
        {
            stored = await JS.InvokeAsync<string?>(
                "semperSounds.getPreference", BoardPreferencesJson.StorageKey);
        }
        catch (JSException)
        {
            // Nothing here is worth killing the circuit over; the default board is fine.
            return;
        }

        var restored = BoardPreferencesJson.Deserialize(stored);

        // Drop choices that no longer match anything, or the viewer gets an empty grid with
        // no visible reason: the uploader may have had every sound deleted, and a tag can be
        // renamed away underneath a saved preference.
        if (restored.UploaderId is { } uploaderId && _uploaders.All(u => u.Id != uploaderId))
        {
            restored = restored with { UploaderId = null };
        }

        var tags = (restored.Tags ?? []).Where(_allTags.Contains).ToList();

        _preferences = restored with { Tags = tags };
        _selectedTags = tags;
        _selectedFilters = [.. Enum.GetValues<BoardFilter>()
            .Where(flag => flag != BoardFilter.None && restored.Filters.HasFlag(flag))];

        ApplyView();
        StateHasChanged();
    }

    private async Task SavePreferencesAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "semperSounds.setPreference",
                BoardPreferencesJson.StorageKey,
                BoardPreferencesJson.Serialize(_preferences));
        }
        catch (JSException)
        {
            // Losing a saved preference is not worth surfacing, let alone throwing over.
        }
    }

    /// <summary>
    /// Plays the favourite in the pressed slot. Looking up by slot rather than by position
    /// in the grid is the point: the key means one sound, and searching or filtering no
    /// longer silently changes what it does.
    /// </summary>
    [JSInvokable]
    public async Task OnHotkey(string key)
    {
        if (!_canPlay || key.Length != 1 || !int.TryParse(key, out var slot))
        {
            return;
        }

        var favorite = _favorites.FirstOrDefault(f => f.Slot == slot);
        if (favorite?.Sound is null)
        {
            return;
        }

        await Play(favorite.Sound);
        StateHasChanged();
    }

    private DotNetObjectReference<Home>? _hotkeyRef;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    public void Dispose()
    {
        Events.SoundPlayed -= OnSoundPlayed;
        Events.LibraryChanged -= OnLibraryChanged;
        Events.ConnectionChanged -= OnConnectionActivity;
        Events.VoiceStateChanged -= OnConnectionChanged;
        Events.PlaybackChanged -= OnPlaybackChanged;
        _hotkeyRef?.Dispose();
    }
}
