@page "/log"
@attribute [Authorize]
@implements IDisposable
@inject ActivityLog Activity
@inject SoundboardEvents Events

<PageTitle>Log · SemperSounds</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Activity</MudText>

<MudTable Items="_entries" Dense="true" Hover="true" Striped="true" Elevation="2">
    <HeaderContent>
        <MudTh>When</MudTh>
        <MudTh>What</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="When" Style="white-space: nowrap;">
            @context.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        </MudTd>
        <MudTd DataLabel="What">
            <ActivityLine Entry="@context" AvatarPixels="20" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2">Nothing has happened yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<ActivityLogEntry> _entries = [];

    protected override async Task OnInitializedAsync()
    {
        Events.SoundPlayed += OnChanged;
        Events.ConnectionChanged += OnChanged;
        _entries = await Activity.GetRecentAsync(500);
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        _entries = await Activity.GetRecentAsync(500);
        StateHasChanged();
    });

    private void OnChanged(SoundPlayedNotification _) => OnChanged();

    public void Dispose()
    {
        Events.SoundPlayed -= OnChanged;
        Events.ConnectionChanged -= OnChanged;
    }
}
