@page "/upload"
@attribute [Authorize]
@implements IAsyncDisposable
@inject SoundLibrary Library
@inject SoundboardEvents Events
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.Extensions.Options.IOptions<Core.Configuration.SoundboardOptions> Options

<PageTitle>Upload · SemperSounds</PageTitle>

@if (_showTips)
{
    <section class="mace-tip-reel" role="region" aria-labelledby="mace-tip-title">
        <button type="button" class="mace-tip-close" aria-label="Close sound creation tips" @onclick="CloseTipsAsync">×</button>

        <div class="mace-tip-heading">
            <span class="mace-tip-star" aria-hidden="true">★</span>
            <h2 id="mace-tip-title">Mace's Sound Creation Tips</h2>
            <span class="mace-tip-star" aria-hidden="true">★</span>
        </div>

        <div class="mace-tip-content">
            <button type="button" class="mace-tip-nav" aria-label="Previous sound creation tip" aria-controls="mace-current-tip" @onclick="ShowPreviousTip">‹</button>
            <div class="mace-tip-stage" aria-live="polite" aria-atomic="true">
                <p id="mace-current-tip" class="mace-tip" @key="_tipIndex">@Tips[_tipIndex]</p>
            </div>
            <button type="button" class="mace-tip-nav" aria-label="Next sound creation tip" aria-controls="mace-current-tip" @onclick="ShowNextTip">›</button>
        </div>

        <div class="mace-tip-progress" aria-hidden="true">
            @for (var index = 0; index < Tips.Length; index++)
            {
                <span class="mace-tip-dot @(index == _tipIndex ? "is-active" : null)"></span>
            }
        </div>
    </section>
}

<MudText Typo="Typo.h5" GutterBottom="true">Add a sound</MudText>

<MudPaper Class="pa-6" Elevation="2" Style="max-width: 640px;">
    <MudStack Spacing="4">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            Longer files are fine — trim them down to
            @Options.Value.MaxDurationSeconds.ToString("0.#") seconds or less below.
            Volume is levelled automatically on upload.
        </MudAlert>

        @* The trimmer reads the chosen file straight out of this input, so the audio is
           decoded in the browser and never round-trips to the server while scrubbing. *@
        <div id="sound-file-host">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileChanged" Accept=".mp3,.wav,.ogg,.m4a,audio/*" />
        </div>

        @if (_file is not null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Selected: <b>@_file.Name</b> (@((_file.Size / 1024d).ToString("0")) KB)
            </MudText>

            <WaveformTrimmer @ref="_trimmer"
                             FileInputSelector="#sound-file-host input[type=file]"
                             MaxLengthSeconds="@Options.Value.MaxDurationSeconds"
                             SelectionChanged="OnTrimChanged" />
        }

        <div class="d-flex align-center gap-4">
            <EmojiPicker Value="@_emoji" ValueChanged="@(value => _emoji = value)" />
            <MudTextField @bind-Value="_name"
                          Label="Name"
                          Variant="Variant.Outlined"
                          HelperText="Leave blank to use the file name"
                          Class="flex-grow-1" />
        </div>

        <TagEditor Value="@_tags" ValueChanged="@(value => _tags = value)" />

        @if (_uploading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   Disabled="_file is null || _uploading"
                   OnClick="Submit">
            Upload
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private static readonly string[] Tips =
    [
        "Keep it short and spicy.",
        "Choose a clear name. \"Don't fail me again\" over \"1-v-5\"",
        "Choose your emoji wisely",
        "Use the funky tags!",
        "Start at the fun part.",
        "Preview before uploading.",
    ];

    private static readonly TimeSpan TipInterval = TimeSpan.FromSeconds(6);

    private IBrowserFile? _file;
    private string _name = string.Empty;
    private string _tags = string.Empty;
    private string _emoji = SemperSounds.Core.Sounds.SoundEmoji.DefaultEmoji;
    private string _error = string.Empty;
    private bool _uploading;

    private WaveformTrimmer? _trimmer;
    private TrimRequest? _trim;
    private bool _loadTrimmerOnRender;
    private bool _showTips = true;
    private int _tipIndex;
    private CancellationTokenSource? _tipRotationCancellation;
    private Task? _tipRotationTask;

    private void OnFileChanged(IBrowserFile? file)
    {
        _file = file;
        _error = string.Empty;
        _trim = null;

        if (file is not null && string.IsNullOrWhiteSpace(_name))
        {
            _name = Path.GetFileNameWithoutExtension(file.Name);
        }

        // The trimmer only exists once this render completes, so loading waits for it.
        _loadTrimmerOnRender = file is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _tipRotationCancellation = new CancellationTokenSource();
            _tipRotationTask = RotateTipsAsync(_tipRotationCancellation.Token);
        }

        if (_loadTrimmerOnRender && _trimmer is not null)
        {
            _loadTrimmerOnRender = false;
            await _trimmer.LoadAsync();
        }
    }

    private async Task RotateTipsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TipInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    ShowNextTip();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Expected when the user leaves the upload page.
        }
    }

    private void ShowPreviousTip() => _tipIndex = (_tipIndex - 1 + Tips.Length) % Tips.Length;

    private void ShowNextTip() => _tipIndex = (_tipIndex + 1) % Tips.Length;

    private async Task CloseTipsAsync()
    {
        _showTips = false;
        await StopTipRotationAsync();
    }

    private void OnTrimChanged((double Start, double Length) selection)
    {
        // A zero length means the browser could not decode the file for a waveform. The
        // upload still goes ahead untrimmed, and the server decides whether it is short
        // enough, so a browser that cannot decode an exotic format is not a dead end.
        _trim = selection.Length > 0
            ? new TrimRequest(selection.Start, selection.Length)
            : null;
    }

    private async Task Submit()
    {
        if (_file is null)
        {
            return;
        }

        _uploading = true;
        _error = string.Empty;

        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            // OpenReadStream needs an explicit ceiling; its default is 512 KB, which would
            // truncate most uploads. The real limit is enforced again server-side.
            await using var stream = _file.OpenReadStream(Options.Value.MaxUploadBytes);

            var result = await Library.AddAsync(
                stream,
                _file.Name,
                _name,
                _tags,
                state.User.GetDiscordUserId(),
                state.User.GetDisplayName(),
                _emoji,
                _trim);

            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            Events.RaiseLibraryChanged();
            Snackbar.Add($"Added {result.Sound!.Name}", Severity.Success);
            Navigation.NavigateTo("/board");
        }
        catch (IOException ex)
        {
            _error = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task StopTipRotationAsync()
    {
        if (_tipRotationCancellation is null)
        {
            return;
        }

        _tipRotationCancellation.Cancel();

        if (_tipRotationTask is not null)
        {
            await _tipRotationTask;
        }

        _tipRotationCancellation.Dispose();
        _tipRotationCancellation = null;
        _tipRotationTask = null;
    }

    public async ValueTask DisposeAsync() => await StopTipRotationAsync();
}
