@page "/upload"
@attribute [Authorize]
@using SemperSounds.Core.Sounds
@inject SoundLibrary Library
@inject SoundboardEvents Events
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.Extensions.Options.IOptions<SemperSounds.Core.Configuration.SoundboardOptions> Options

<PageTitle>Upload · SemperSounds</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Add a sound</MudText>

<MudPaper Class="pa-6" Elevation="2" Style="max-width: 640px;">
    <MudStack Spacing="4">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            Longer files are fine — trim them down to
            @Options.Value.MaxDurationSeconds.ToString("0.#") seconds or less below.
            Volume is levelled automatically on upload.
        </MudAlert>

        @* The trimmer reads the chosen file straight out of this input, so the audio is
           decoded in the browser and never round-trips to the server while scrubbing. *@
        <div id="sound-file-host">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileChanged" Accept=".mp3,.wav,.ogg,.m4a,audio/*" />
        </div>

        @if (_file is not null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Selected: <b>@_file.Name</b> (@((_file.Size / 1024d).ToString("0")) KB)
            </MudText>

            <WaveformTrimmer @ref="_trimmer"
                             FileInputSelector="#sound-file-host input[type=file]"
                             MaxLengthSeconds="@Options.Value.MaxDurationSeconds"
                             SelectionChanged="OnTrimChanged" />
        }

        <div class="d-flex align-center gap-4">
            <EmojiPicker Value="@_emoji" ValueChanged="@(value => _emoji = value)" />
            <MudTextField @bind-Value="_name"
                          Label="Name"
                          Variant="Variant.Outlined"
                          HelperText="Leave blank to use the file name"
                          Class="flex-grow-1" />
        </div>

        <TagEditor Value="@_tags" ValueChanged="@(value => _tags = value)" />

        @if (_uploading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   Disabled="_file is null || _uploading"
                   OnClick="Submit">
            Upload
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private IBrowserFile? _file;
    private string _name = string.Empty;
    private string _tags = string.Empty;
    private string _emoji = SemperSounds.Core.Sounds.SoundEmoji.DefaultEmoji;
    private string _error = string.Empty;
    private bool _uploading;

    private WaveformTrimmer? _trimmer;
    private TrimRequest? _trim;
    private bool _loadTrimmerOnRender;

    private void OnFileChanged(IBrowserFile? file)
    {
        _file = file;
        _error = string.Empty;
        _trim = null;

        if (file is not null && string.IsNullOrWhiteSpace(_name))
        {
            _name = Path.GetFileNameWithoutExtension(file.Name);
        }

        // The trimmer only exists once this render completes, so loading waits for it.
        _loadTrimmerOnRender = file is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loadTrimmerOnRender && _trimmer is not null)
        {
            _loadTrimmerOnRender = false;
            await _trimmer.LoadAsync();
        }
    }

    private void OnTrimChanged((double Start, double Length) selection)
    {
        // A zero length means the browser could not decode the file for a waveform. The
        // upload still goes ahead untrimmed, and the server decides whether it is short
        // enough, so a browser that cannot decode an exotic format is not a dead end.
        _trim = selection.Length > 0
            ? new TrimRequest(selection.Start, selection.Length)
            : null;
    }

    private async Task Submit()
    {
        if (_file is null)
        {
            return;
        }

        _uploading = true;
        _error = string.Empty;

        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            // OpenReadStream needs an explicit ceiling; its default is 512 KB, which would
            // truncate most uploads. The real limit is enforced again server-side.
            await using var stream = _file.OpenReadStream(Options.Value.MaxUploadBytes);

            var result = await Library.AddAsync(
                stream,
                _file.Name,
                _name,
                _tags,
                state.User.GetDiscordUserId(),
                state.User.GetDisplayName(),
                _emoji,
                _trim);

            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            Events.RaiseLibraryChanged();
            Snackbar.Add($"Added {result.Sound!.Name}", Severity.Success);
            Navigation.NavigateTo("/");
        }
        catch (IOException ex)
        {
            _error = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }
}
