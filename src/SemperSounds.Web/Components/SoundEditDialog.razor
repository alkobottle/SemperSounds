@using SemperSounds.Core.Sounds

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Style="min-width: 380px;">
            <div class="d-flex align-center gap-4">
                <EmojiPicker Value="@_emoji" ValueChanged="@(value => _emoji = value)" />
                <MudTextField @bind-Value="_name"
                              Label="Name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Error="@_nameError"
                              ErrorText="A name is required"
                              Immediate="true" />
            </div>

            <MudTextField @bind-Value="_tags"
                          Label="Tags"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          HelperText="Comma separated" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public Sound Sound { get; set; } = default!;

    private string _name = string.Empty;
    private string _tags = string.Empty;
    private string _emoji = SoundEmoji.DefaultEmoji;
    private bool _nameError;

    protected override void OnInitialized()
    {
        _name = Sound.Name;
        _tags = Sound.Tags;
        _emoji = Sound.Emoji;
    }

    private void Cancel() => Dialog.Cancel();

    private void Save()
    {
        _nameError = string.IsNullOrWhiteSpace(_name);
        if (_nameError)
        {
            return;
        }

        Dialog.Close(DialogResult.Ok(new SoundEdit(_name, _tags, _emoji)));
    }

    public sealed record SoundEdit(string Name, string Tags, string Emoji);
}
