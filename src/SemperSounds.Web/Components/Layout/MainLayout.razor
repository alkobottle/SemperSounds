@inherits LayoutComponentBase

@* MudBlazor's providers must render interactively or dialogs, snackbars and popovers
   silently do nothing. App.razor puts InteractiveServer on Routes globally, which covers this. *@
<MudThemeProvider Theme="SemperSoundsTheme.Instance" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.GraphicEq" Class="mr-3" />
        <MudText Typo="Typo.h6" Class="mr-6">SemperSounds</MudText>

        <MudButton Href="/" StartIcon="@Icons.Material.Filled.Apps" Color="Color.Inherit">Board</MudButton>
        <MudButton Href="/upload" StartIcon="@Icons.Material.Filled.Upload" Color="Color.Inherit">Upload</MudButton>
        <MudButton Href="/log" StartIcon="@Icons.Material.Filled.History" Color="Color.Inherit">Log</MudButton>

        <MudSpacer />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
