@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<SemperSounds.Core.Configuration.AppOptions> AppSettings

@* MudBlazor's providers must render interactively or dialogs, snackbars and popovers
   silently do nothing. App.razor puts InteractiveServer on Routes globally, which covers this. *@
<MudThemeProvider Theme="SemperSoundsTheme.Instance" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        @* Color.Inherit on the link itself, not just the text: MudLink otherwise paints
           the wordmark link-blue against the app bar. *@
        <MudLink Href="/board" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center mr-6">
            <img src="logo.svg" alt="" width="34" height="34" class="mr-3" />
            <MudText Typo="Typo.h6" Color="Color.Inherit">SemperSounds</MudText>
        </MudLink>

        <AuthorizeView>
            <Authorized>
                <MudButton Href="/board" StartIcon="@Icons.Material.Filled.Apps" Color="Color.Inherit">Board</MudButton>
                <MudButton Href="/upload" StartIcon="@Icons.Material.Filled.Upload" Color="Color.Inherit">Upload</MudButton>
                <MudButton Href="/log" StartIcon="@Icons.Material.Filled.History" Color="Color.Inherit">Log</MudButton>

                <MudSpacer />

                <VoiceBar />

                <MudTooltip Text="@context.User.GetDisplayName()">
                    <MudAvatar Size="Size.Small" Class="ml-4">
                        @if (context.User.GetAvatarUrl() is { } avatar)
                        {
                            <MudImage Src="@avatar" />
                        }
                        else
                        {
                            @context.User.GetDisplayName()[0]
                        }
                    </MudAvatar>
                </MudTooltip>

                <form action="/logout" method="post" class="d-flex">
                    <AntiforgeryToken />
                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Color="Color.Inherit"
                                   ButtonType="ButtonType.Submit"
                                   aria-label="Sign out"
                                   title="Sign out" />
                </form>
            </Authorized>
            <NotAuthorized>
                <MudSpacer />
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
            @Body

            @* Which build is live. Small and muted, but present on every page so it can be
               read off a screenshot without digging. *@
            @* Centred by inline style, not a class: MudBlazor ships no text-center, and
               Bootstrap is gone, so the class form silently does nothing. *@
            <MudText Typo="Typo.caption"
                     Class="mud-text-secondary d-block mt-8 mb-4"
                     Style="text-align: center;"
                     title="@BuildTooltip">
                SemperSounds @AppSettings.Value.DisplayVersion
            </MudText>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private string BuildTooltip =>
        string.IsNullOrWhiteSpace(AppSettings.Value.BuiltAt) || AppSettings.Value.BuiltAt == "unknown"
            ? "Not built through Docker"
            : $"Built {AppSettings.Value.BuiltAt}";
}
