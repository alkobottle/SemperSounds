@using SemperSounds.Core.Sounds
@inject GuildEmojiProvider GuildEmojis

@* Open state is managed here rather than left to MudMenu. With custom ActivatorContent
   MudMenu attaches no click handler of its own — the activator has to trigger it — and
   owning the state also lets the menu close as soon as an emoji is chosen. *@
<MudMenu Open="_open"
         OpenChanged="@(value => _open = value)"
         AnchorOrigin="Origin.BottomLeft"
         TransformOrigin="Origin.TopLeft">
    <ActivatorContent>
        <MudButton Variant="Variant.Outlined"
                   Class="pa-2"
                   Style="min-width: 56px;"
                   aria-label="Choose an emoji"
                   OnClick="@(() => _open = !_open)">
            <SoundEmojiView Value="@Value" Size="28" />
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        <div style="width: 320px; max-height: 380px; overflow-y: auto;" class="pa-3">

            @* Filters both sections at once. The server emoji match on their own name, the
               curated ones on their keywords, so one box covers the whole panel. *@
            <MudTextField T="string"
                          @bind-Value="_search"
                          @bind-Value:after="StateHasChanged"
                          Immediate="true"
                          Placeholder="Search emoji"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Class="mb-3" />

            @if (MatchingGuildEmojis is { Count: > 0 } guildMatches)
            {
                <MudText Typo="Typo.overline">@guildMatches.Count server emoji</MudText>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var emoji in guildMatches)
                    {
                        <MudTooltip Text="@($":{emoji.Name}:")">
                            <MudIconButton Size="Size.Small" OnClick="@(() => Select(emoji.Raw))">
                                <img src="@emoji.ImageUrl" alt="@emoji.Name" width="22" height="22"
                                     loading="lazy" style="object-fit: contain;" />
                            </MudIconButton>
                        </MudTooltip>
                    }
                </div>
            }
            else if (_guildEmojis.Count == 0 && string.IsNullOrWhiteSpace(_search))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    No server emoji available — the bot may still be connecting.
                </MudText>
            }

            @foreach (var category in MatchingCategories)
            {
                <MudText Typo="Typo.overline">@category.Name</MudText>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var entry in category.Entries)
                    {
                        <MudTooltip Text="@entry.Keywords">
                            <MudIconButton Size="Size.Small" OnClick="@(() => Select(entry.Emoji))">
                                <span style="font-size: 20px; line-height: 1;">@entry.Emoji</span>
                            </MudIconButton>
                        </MudTooltip>
                    }
                </div>
            }

            @if (MatchingCategories.Count == 0 && MatchingGuildEmojis.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">
                    Nothing matches that. Paste the emoji below instead.
                </MudText>
            }

            <MudTextField T="string"
                          @bind-Value="_pasted"
                          @bind-Value:after="ApplyPasted"
                          Immediate="true"
                          Label="Or paste any emoji"
                          HelperText="Win + . opens the system emoji picker"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

            @if (_pasteError)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">That is not an emoji.</MudText>
            }
        </div>
    </ChildContent>
</MudMenu>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = SoundEmoji.DefaultEmoji;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private IReadOnlyList<GuildEmoji> _guildEmojis = [];
    private string _search = string.Empty;
    private string _pasted = string.Empty;
    private bool _pasteError;
    private bool _open;

    protected override void OnInitialized() => _guildEmojis = GuildEmojis.GetAll();

    private IReadOnlyList<EmojiCategory> MatchingCategories => EmojiCatalog.Search(_search);

    /// <remarks>A guild's list is unbounded, which is the other half of why the search box
    /// is here: a server with hundreds of emoji buries the curated set without it.</remarks>
    private IReadOnlyList<GuildEmoji> MatchingGuildEmojis =>
        string.IsNullOrWhiteSpace(_search)
            ? _guildEmojis
            : [.. _guildEmojis.Where(e => e.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))];

    private async Task Select(string raw)
    {
        _pasteError = false;
        _open = false;
        // Left as it was rather than cleared: reopening the picker to try a neighbouring
        // emoji is the common case, and re-typing the same term to get back is a chore.
        await ValueChanged.InvokeAsync(raw);
    }

    private async Task ApplyPasted()
    {
        if (string.IsNullOrWhiteSpace(_pasted))
        {
            _pasteError = false;
            return;
        }

        if (SoundEmoji.TryParse(_pasted, out var emoji))
        {
            _pasted = string.Empty;
            await Select(emoji.Raw);
        }
        else
        {
            _pasteError = true;
        }
    }
}
