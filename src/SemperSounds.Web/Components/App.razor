@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SemperSounds.Web.styles.css"]" />
    <ImportMap />
    @* SVG first so the tab icon stays sharp on high-DPI displays; the PNG is only
       fetched by browsers that will not take an SVG icon. *@
    <link rel="icon" type="image/svg+xml" href="@Assets["logo.svg"]" />
    <link rel="alternate icon" type="image/png" href="@Assets["favicon.png"]" />
    <link rel="apple-touch-icon" href="@Assets["favicon.png"]" />

    @* Link preview card. Static rather than per-page head content because the crawlers that
       read it run no JavaScript, and the image must be a raster at an absolute URL — Discord
       will not render the SVG logo. Without these, Discord followed the sign-in redirect and
       showed its own marketing card instead. *@
    <meta property="og:site_name" content="SemperSounds" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="SemperSounds" />
    <meta property="og:description" content="A soundboard for your Discord server, without the handful-of-slots limit. Overlapping playback, in-browser trimming, and favourites on keys 1-9." />
    <meta property="og:url" content="@BaseUrl" />
    <meta property="og:image" content="@($"{BaseUrl}favicon.png")" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="theme-color" content="#E11C33" />
    <meta name="description" content="A soundboard for your Discord server, without the handful-of-slots limit." />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/sempersounds.js"]"></script>
    <script src="@Assets["js/trimmer.js"]"></script>
</body>

</html>

@code {
    /// <summary>
    /// Absolute base URL, with a trailing slash. Correct behind the reverse proxy because
    /// Program.cs rewrites the request scheme and host from App__PublicBaseUrl before this
    /// renders — otherwise the card would advertise the container's internal address.
    /// </summary>
    private string BaseUrl => Navigation.BaseUri;
}
